# # ============================================================
# # Maklin Admin API — Environment Variables
# # ============================================================
# # LOCAL: copy to .env and fill values
# # RENDER: do NOT commit .env — set these in Render → Environment
# # ============================================================

# # --- Required on Render ---
# # Paste "Internal Database URL" from your Render Postgres service
# # Example: postgresql://USER:PASSWORD@dpg-xxxxx-a/maklin
# DATABASE_URL="postgresql://postgres:321@localhost:5432/maklin?schema=public"

# # Admin panel secret (x-admin-secret header)
# ADMIN_SECRET="change-me-to-a-strong-secret"

# # Render sets PORT automatically (usually 10000). Optional locally:
# PORT=3000

# APP_NAME="Maklin Admin"

# # ============================================================
# # LOCAL development only (your PC Postgres):
# # DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/maklin?schema=public"
# # ============================================================


# LOCAL development — use External URL (Internal host only works inside Render)
DATABASE_URL="postgresql://maklin_user:scf7QvA1rJUfAvvauqRLTtGEwzQRYKS3@dpg-d9oqi6u7bikc73fsbc5g-a.ohio-postgres.render.com/maklin?schema=public"

# Admin panel secret (x-admin-secret header)
ADMIN_SECRET="change-me-to-a-strong-secret"

PORT=3000
APP_NAME="Maklin Admin"

# ------------------------------------------------------------
# RENDER WEB SERVICE (dashboard → Environment) — set manually:
# DATABASE_URL = Internal URL (do NOT use localhost):
# postgresql://maklin_user:scf7QvA1rJUfAvvauqRLTtGEwzQRYKS3@dpg-d9oqi6u7bikc73fsbc5g-a/maklin
# ADMIN_SECRET = maklin123@
# ------------------------------------------------------------
