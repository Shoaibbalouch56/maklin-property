# LOCAL only — your PC Postgres
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/maklin?schema=public"

# RENDER / production — use the Render Postgres "Internal Database URL"
# Example:
# DATABASE_URL="postgresql://USER:PASSWORD@dpg-xxxxx-a/maklin?schema=public"

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/maklin?schema=public"

# Shared secret for admin panel (send as x-admin-secret header)
ADMIN_SECRET="change-me-to-a-long-random-secret"

# Render sets PORT automatically — do not hardcode 5432 for the DB host
PORT=3000
APP_NAME="Maklin Admin"
